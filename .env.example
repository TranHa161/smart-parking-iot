# Sao chép thành .env (02-init.sh tự làm việc này trên server).
# KHÔNG commit file .env.

# --- Tên miền / SSL ---
DOMAIN=myparking.duckdns.org
DUCKDNS_TOKEN=
LETSENCRYPT_EMAIL=

# --- PostgreSQL ---
POSTGRES_DB=parking
POSTGRES_USER=parking
POSTGRES_PASSWORD=

# --- Redis ---
REDIS_PASSWORD=

# --- MQTT (Mosquitto) ---
MQTT_USER=parking_gw
MQTT_PASSWORD=

# --- Backend ---
APP_SECRET_KEY=
