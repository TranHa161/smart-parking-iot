PROJECT_NAME="Smart Parking IoT Backend"
API_V1_STR="/api"

DATABASE_URL="sqlite+aiosqlite:///./parking.db"
# DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/parking_db"

REDIS_URL="redis://localhost:6379/0"

MQTT_BROKER_HOST="localhost"
MQTT_BROKER_PORT=1883

BOOKING_EXPIRATION_MINUTES=15
HOURLY_RATE=10000


# Hạn quẹt RFID IN sau khi được cấp thẻ (QR đã verify hoặc khách vãng lai)
ENTRY_AUTHORIZATION_MINUTES=15
SLOT_COUNT=3

# Bảo mật & tài khoản khởi tạo
SECRET_KEY="dev-secret-change-in-production"
ACCESS_TOKEN_HOURS=12
SEED_ADMIN_EMAIL="admin@parking.com"
SEED_ADMIN_PASSWORD=""
SEED_DEMO_USERS=true

